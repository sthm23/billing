# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL=postgresql://postgres:postgres_password_change_me@postgres:5432/billing

# PostgreSQL Container Settings
POSTGRES_DB=billing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_PORT=5432
POSTGRES_OUTPUT_PORT=5432

# ==============================================
# Server Configuration
# ==============================================
PORT=4000
NODE_ENV=production

# ==============================================
# JWT Authentication
# ==============================================
# IMPORTANT: Change these in production!
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRE=7d

# ==============================================
# AWS S3 Configuration
# ==============================================
# For LocalStack (development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_BUCKET=billing-bucket
AWS_ENDPOINT=http://localstack:4566

# For real AWS (production) - uncomment and configure
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_BUCKET=your-production-bucket
# AWS_ENDPOINT=  # Leave empty for real AWS

# ==============================================
# Monitoring (Optional)
# ==============================================
# Grafana
GRAFANA_PASSWORD=admin

# Loki (log aggregation)
LOKI_URL=http://loki:3100

# ==============================================
# Production Security Checklist
# ==============================================
# Before deploying to production:
#
# ✓ Generate strong secrets:
#   openssl rand -base64 32
#
# ✓ Never commit real secrets to git
#
# ✓ Use secrets management (AWS Secrets Manager, HashiCorp Vault, etc.)
#
# ✓ Rotate secrets regularly
#
# ✓ Use different credentials for each environment (dev/staging/prod)
#
# ✓ Restrict database access (comment out POSTGRES_OUTPUT_PORT in docker-compose.yml)
#
# ✓ Enable SSL for database connections in production
#
# ✓ Review all environment variables before deployment
