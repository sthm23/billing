JWT_ACCESS_SECRET=access_secret_example
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_SECRET=refresh_secret_example
JWT_REFRESH_EXPIRE=30d

SUPER_ADMIN_PASSWORD=super_admin_password_example
SALT=10
PORT=4000

AWS_SECRET_ACCESS_KEY=aws_secret_access_key_example
AWS_ACCESS_KEY_ID=aws_access_key_id_example
AWS_S3_BUCKET_NAME=sthm-media-dev
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
# Uztelecom Object Storage (S3-compatible, path-style); public URL includes the bucket
S3_ENDPOINT=https://s3.uztelecom.uz
S3_PUBLIC_URL=https://s3.uztelecom.uz/sthm-media-dev

POSTGRES_DB=pg_database_example
POSTGRES_USER=pg_user_example
POSTGRES_PASSWORD=pg_password_example
POSTGRES_PORT=5432
POSTGRES_OUTPUT_PORT=5432
DATABASE_URL="postgresql://pg_user_example:pg_password_example@localhost:5432/pg_database_example?schema=public"

GRAFANA_PASSWORD=grafana_password_example

LOKI_URL=http://localhost:3100