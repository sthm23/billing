JWT_ACCESS_SECRET=access_secret_example
JWT_ACCESS_EXPIRE=30m
JWT_REFRESH_SECRET=refresh_secret_example
JWT_REFRESH_EXPIRE=30d

SUPER_ADMIN_PASSWORD=super_admin_password_example
SALT=10
PORT=4000

AWS_SECRET_ACCESS_KEY=aws_secret_access_key_example
AWS_ACCESS_KEY_ID=aws_access_key_id_example
AWS_S3_BUCKET_NAME=sthm-media-dev
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
# Uztelecom Object Storage (S3-compatible, path-style); public URL includes the bucket
S3_ENDPOINT=https://s3.uztelecom.uz
S3_PUBLIC_URL=https://s3.uztelecom.uz/sthm-media-dev

POSTGRES_DB=pg_database_example
POSTGRES_USER=pg_user_example
POSTGRES_PASSWORD=pg_password_example
POSTGRES_PORT=5432
POSTGRES_OUTPUT_PORT=5432
DATABASE_URL="postgresql://pg_user_example:pg_password_example@localhost:5432/pg_database_example?schema=public"

GRAFANA_PASSWORD=grafana_password_example

LOKI_URL=http://localhost:3100
# Order assistant speech-to-text (billing/stt-service, local only)
STT_URL=http://127.0.0.1:8090
# Private bucket for voice samples kept with the store's consent (docs/voice-order/STT_SERVICE.md §6).
# Same endpoint and keys as the photo bucket. Unset → recordings are never kept.
VOICE_S3_BUCKET_NAME=sthm-voice-dev

# Telegram shop (docs/telegram-shop/PLAN.md). Unset → the shop answers 503, the API still starts.
# AES-256 key for bot tokens: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing the key makes the stored tokens unreadable: owners would have to paste them again.
TELEGRAM_TOKEN_KEY=
# Public HTTPS address of this API (nginx); Telegram calls <it>/api/telegram-shop/webhook/<slug>
TELEGRAM_WEBHOOK_BASE_URL=https://sthm23.uz
# Shared Mini App; a shop opens at <it>/<slug>
TELEGRAM_MINIAPP_URL=https://shop.sthm23.uz
