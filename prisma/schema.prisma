generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/**
 * =======================
 * AUTH & USERS
 * =======================
 */

model User {
  id              String           @id @default(uuid())
  fullName        String
  phone           String           @unique
  role            UserRole         @default(USER)
  type            UserType
  createdAt       DateTime         @default(now())
  image           String?
  auth            AuthAccount?
  customer        Customer?
  refreshSessions RefreshSession[]
  staff           Staff?
  stores          Store[] //created stores by this auth account
  categories      Category[] // subcategories created by this user

  @@map("users")
}

model AuthAccount {
  id           String   @id @default(uuid())
  userId       String   @unique
  login        String   @unique // e.g. email or username or phone
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@map("auth_accounts")
}

model RefreshSession {
  id          String   @id @default(uuid())
  userId      String
  refreshHash String
  userAgent   String? // браузер / устройство
  ip          String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  isRevoked   Boolean  @default(false) // когда сессия была отозвана
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_sessions")
}

/**
 * =======================
 * STORES & STAFF
 * =======================
 */

model Store {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  createdBy String // admin auth account id
  creator   User   @relation(fields: [createdBy], references: [id])

  /// Store sells goods (orders, payments, returns of sales)
  salesEnabled  Boolean @default(true)
  /// Store rents goods out (rental module); at least one of the two flags is true
  rentalEnabled Boolean @default(false)

  /// Subscription state: TRIAL (first month, free) → ACTIVE (paid) → SUSPENDED (blocked by an admin)
  status         StoreStatus         @default(TRIAL)
  /// End of the free trial (createdAt + 1 month); no auto-suspend when it passes
  trialEndsAt    DateTime?
  /// Paid until — entered by the admin when the store is resumed / paid
  paidUntil      DateTime?
  suspendedAt    DateTime?
  /// User id of the admin who suspended the store (no FK: users are never deleted)
  suspendedById  String?
  suspendReason  StoreSuspendReason?
  /// Optional comment for the owner shown with the suspension
  suspendComment String?

  /// Application data entered by the admin
  address String?
  /// Taxpayer number (INN), exactly 9 digits
  inn     String?
  note    String?

  warehouse Warehouse[]
  staff     Staff[]
  customers Customer[]  @relation("CustomerStores")
  orders    Order[]

  categories    CategoriesOnStore[]
  brands        BrandsOnStore[]
  attributes    AttributeOnStore[]
  cashboxes     Cashbox[]
  customerDebts CustomerDebt[]

  @@map("stores")
}

model Customer {
  id            String         @id @default(uuid())
  userId        String         @unique
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id])
  stores        Store[]        @relation("CustomerStores")
  orders        Order[]        @relation("CustomerOrders")
  customerDebts CustomerDebt[]

  @@map("customers")
}

model Staff {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  storeId            String
  role               StaffRole
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  /// Set when the owner deactivates the employee; cleared on restore
  deactivatedAt      DateTime?
  /// User id of who deactivated (no FK: users are never deleted)
  deactivatedById    String?
  deactivationReason StaffDeactivationReason?

  returnPayments   ReturnPayment[]    @relation("ReturnPayments")
  orders           Order[]            @relation("StaffOrders")
  payments         Payment[]          @relation("StaffPayments")
  store            Store              @relation(fields: [storeId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  warehouse        StaffOnWarehouse[]
  stockMoves       StockMovement[]
  cashboxes        Cashbox[]
  cashTransactions CashTransaction[]
  debtPayments     DebtPayment[]

  @@index([storeId])
  @@map("staff")
}

model StaffOnWarehouse {
  staffId     String
  warehouseId String
  staff       Staff     @relation(fields: [staffId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([staffId, warehouseId])
  @@map("staff_on_warehouses")
}

/**
 * =======================
 * WAREHOUSES
 * =======================
 */

model Warehouse {
  id              String             @id @default(uuid())
  storeId         String
  name            String
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  inventory       Inventory[]
  orders          Order[]
  staffs          StaffOnWarehouse[]
  stockMovements  StockMovement[]
  products        Product[]
  store           Store              @relation(fields: [storeId], references: [id])
  cashboxes       Cashbox[]
  rentalCleanings RentalCleaning[]

  @@index([storeId])
  @@map("warehouses")
}

/**
 * =======================
 * PRODUCTS & VARIANTS
 * =======================
 */

model Brand {
  id       String          @id @default(uuid())
  name     String          @unique
  stores   BrandsOnStore[]
  products Product[]

  @@map("brands")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  /// Object key in the media bucket: products/<storeId>/<file>. The API builds the public URL from S3_PUBLIC_URL.
  key       String
  isMain    Boolean @default(false)
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId, isMain])
  @@map("product_images")
}

model Tag {
  id     String     @id @default(uuid())
  name   String     @unique
  values TagValue[] // например "latex", "cotton" для тега "material"

  @@map("tags")
}

model TagValue {
  id      String            @id @default(uuid())
  tagId   String
  value   String
  product ProductTagValue[]
  tag     Tag               @relation(fields: [tagId], references: [id])

  @@unique([tagId, value])
  @@map("tag_values")
}

model ProductTagValue {
  productId  String
  tagValueId String
  product    Product  @relation(fields: [productId], references: [id])
  value      TagValue @relation(fields: [tagValueId], references: [id])

  @@id([productId, tagValueId])
  @@map("product_tag_values")
}

model Product {
  id          String   @id @default(uuid())
  warehouseId String
  storeId     String // для быстрого доступа к магазину, которому принадлежит товар
  name        String
  categoryId  String?
  brandId     String?
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  warehouse  Warehouse          @relation(fields: [warehouseId], references: [id])
  category   Category?          @relation(fields: [categoryId], references: [id])
  brand      Brand?             @relation(fields: [brandId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  attributes ProductAttribute[]
  tags       ProductTagValue[]

  @@index([warehouseId])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id                  String                  @id @default(uuid())
  productId           String
  sku                 String // ску будет уникален в пределах магазина
  barCode             String?
  price               Decimal // sale price
  /// Variant can be sold (existing order flow rejects it otherwise)
  canSell             Boolean                 @default(true)
  /// Variant can be rented out; then rentPricePerDay > 0 is required
  canRent             Boolean                 @default(false)
  rentPricePerDay     Decimal?
  /// Dry-cleaning days suggested when the variant comes back from a rental (0 = none)
  defaultCleaningDays Int                     @default(1)
  createdAt           DateTime                @default(now())
  storeId             String // это для быстрого поиска уникального SKU в пределах магазина
  warehouseId         String // это для быстрого доступа к складу, на котором лежит товар
  inventory           Inventory[]
  orderItems          OrderItem[]
  product             Product                 @relation(fields: [productId], references: [id])
  stockMovements      StockMovement[]
  attributes          VariantAttributeValue[]
  rentalCleanings     RentalCleaning[]

  @@unique([storeId, sku])
  @@unique([barCode])
  @@index([productId])
  @@map("product_variants")
}

/**
 * =======================
 * INVENTORY
 * =======================
 */

model Inventory {
  id          String         @id @default(uuid())
  warehouseId String
  variantId   String
  quantity    Int
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, variantId])
  @@map("inventories")
}

/**
 * складские движения приход/расход
 * =======================
 * STOCK MOVEMENTS
 * =======================
 */
model StockMovement {
  id          String              @id @default(uuid())
  variantId   String
  warehouseId String
  type        StockMovementType
  reason      StockMovementReason
  quantity    Int
  unitCost    Decimal? // только для IN себестоимость
  createdById String
  createdAt   DateTime            @default(now())
  variant     ProductVariant      @relation(fields: [variantId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy   Staff               @relation(fields: [createdById], references: [id])

  @@index([warehouseId, createdAt])
  @@index([variantId, createdAt])
  @@map("stock_movements")
}

/**
 * =======================
 * CATALOG
 * =======================
 */

/// Two levels: parentId = null → store direction (system, seed); parentId = direction → product subcategory.
/// Case-insensitive uniqueness per parent for name / nameUz / nameEn is enforced by partial expression
/// indexes created in SQL (migration 20261113120000_category_two_levels), not representable in Prisma.
model Category {
  id          String              @id @default(uuid())
  name        String // Russian, primary
  nameUz      String?
  nameEn      String?
  parentId    String?
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]          @relation("CategoryTree")
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  store       CategoriesOnStore[]
  products    Product[]

  @@unique([parentId, name])
  @@index([parentId])
  @@map("categories")
}

/**
 * =======================
 * ATTRIBUTES (FILTERS)
 * =======================
 */

model Attribute {
  id      String             @id @default(uuid())
  name    String             @unique
  type    AttributeType
  /// Unit for NUMBER attributes (м, кг, л); shown as «Длина — 6 м»
  unit    String?
  values  AttributeValue[]
  store   AttributeOnStore[]
  product ProductAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id          String                  @id @default(uuid())
  attributeId String
  valueString String?
  valueNumber Decimal?
  valueBool   Boolean?
  attribute   Attribute               @relation(fields: [attributeId], references: [id])
  variant     VariantAttributeValue[]

  @@unique([attributeId, valueString, valueNumber, valueBool])
}

model BarcodeSequence {
  id        Int      @id @default(1)
  nextCode  BigInt   @default(200000000000)
  updatedAt DateTime @updatedAt
}

model ProductAttribute {
  productId   String
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@id([productId, attributeId])
  @@map("product_attributes")
}

model VariantAttributeValue {
  variantId        String
  attributeValueId String
  value            AttributeValue @relation(fields: [attributeValueId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id])

  @@id([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

model CategoriesOnStore {
  storeId    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  store      Store    @relation(fields: [storeId], references: [id])

  @@id([storeId, categoryId])
  @@map("categories_on_stores")
}

model BrandsOnStore {
  storeId String
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])
  store   Store  @relation(fields: [storeId], references: [id])

  @@id([storeId, brandId])
  @@map("brands_on_stores")
}

model AttributeOnStore {
  storeId     String
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  store       Store     @relation(fields: [storeId], references: [id])

  @@id([storeId, attributeId])
  @@map("attributes_on_stores")
}

/**
 * =======================
 * ORDERS & SALES
 * =======================
 */

model Order {
  id          String       @id @default(uuid())
  storeId     String
  warehouseId String
  cashierId   String
  customerId  String?
  channel     OrderChannel
  status      OrderStatus
  totalAmount Decimal
  paidAmount  Decimal      @default(0)
  createdAt   DateTime     @default(now())
  /// Set once when the order becomes COMPLETED or DEBT (the sale)
  soldAt      DateTime?

  isReturned     Boolean             @default(false)
  returnedAt     DateTime?
  returnedAmount Decimal             @default(0)
  returns        ReturnedOrder?
  services       AdditionalService[]
  /// Set when the order is a rental (booking); such an order never goes through the sale flow
  rental         Rental?

  store            Store             @relation(fields: [storeId], references: [id])
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  cashier          Staff             @relation("StaffOrders", fields: [cashierId], references: [id])
  customer         Customer?         @relation("CustomerOrders", fields: [customerId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  // delivery  Delivery?
  cashTransactions CashTransaction[]

  @@index([storeId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([storeId, soldAt])
  @@map("orders")
}

model OrderItem {
  id                String             @id @default(uuid())
  orderId           String
  variantId         String
  quantity          Int
  retailPrice       Decimal // Розничная цена на момент продажи, может отличаться от текущей цены в каталоге
  sale              Decimal            @default(0) // Скидка на момент продажи
  costAtSale        Decimal // За сколько закупили
  createdAt         DateTime           @default(now())
  returnItems       ReturnItem?
  rentalReturnItems RentalReturnItem[]
  order             Order              @relation(fields: [orderId], references: [id])
  variant           ProductVariant     @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model AdditionalService {
  id          String   @id @default(uuid())
  orderId     String
  name        String
  price       Decimal
  sale        Decimal  @default(0) // discount on the service, sale <= price
  description String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("additional_services")
}

/**
 * =======================
 * RENTALS
 * Money lives in the Order (items, services, payments); Rental keeps dates
 * and the physical state of the rented items. Renting never changes Inventory.
 * =======================
 */
model Rental {
  id          String @id @default(uuid())
  orderId     String @unique
  storeId     String
  warehouseId String
  customerId  String

  startDate   DateTime // planned issue date
  endDate     DateTime // planned return date
  plannedDays Int // days the price was calculated for

  status                  RentalStatus @default(BOOKED)
  issuedAt                DateTime?
  issuedBy                String? // staffId
  /// Issued while the salon held no collateral (seller's responsibility)
  issuedWithoutCollateral Boolean      @default(false)
  closedAt                DateTime? // all items returned

  cancelledAt  DateTime?
  cancelledBy  String? // staffId
  refundAmount Decimal? // prepayment paid back on cancellation
  cancelReason String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order       Order              @relation(fields: [orderId], references: [id])
  collaterals RentalCollateral[]
  returns     RentalReturn[]

  @@index([storeId, startDate])
  @@index([warehouseId, status])
  @@map("rentals")
}

/// Non-cash collateral (passport, gold); never goes to the cashbox
model RentalCollateral {
  id          String         @id @default(uuid())
  rentalId    String
  type        CollateralType
  description String
  receivedAt  DateTime       @default(now())
  receivedBy  String // staffId
  returnedAt  DateTime?
  returnedBy  String? // staffId

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@map("rental_collaterals")
}

/// One return event (full or partial)
model RentalReturn {
  id                String   @id @default(uuid())
  rentalId          String
  returnedAt        DateTime // actual return time
  penaltyAmount     Decimal  @default(0) // damage / late return, entered by the seller
  penaltyComment    String? // required when penaltyAmount > 0
  earlyReturnRefund Decimal  @default(0) // total reduction on early return, OWNER/MANAGER only
  createdBy         String // staffId
  createdAt         DateTime @default(now())

  rental Rental             @relation(fields: [rentalId], references: [id])
  items  RentalReturnItem[]

  @@index([rentalId])
  @@map("rental_returns")
}

model RentalReturnItem {
  id            String   @id @default(uuid())
  returnId      String
  orderItemId   String
  quantity      Int
  cleaningDays  Int      @default(0) // 0 = no dry cleaning
  availableFrom DateTime // returnedAt + cleaningDays: the unit is free again from here

  return    RentalReturn @relation(fields: [returnId], references: [id])
  orderItem OrderItem    @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
  @@index([orderItemId])
  @@map("rental_return_items")
}

/// Dry cleaning planned by an OWNER/MANAGER outside a return (R13): one unit
/// of the variant is busy on [startDate, endDate) like a booking; the expense
/// goes to the cashbox at once, a cancel before the start writes it back.
model RentalCleaning {
  id          String               @id @default(uuid())
  storeId     String
  warehouseId String
  variantId   String
  startDate   DateTime // 12:00 of the first cleaning day
  endDate     DateTime // 12:00 after the last cleaning day: the unit is free again
  days        Int
  amount      Decimal
  paymentType PaymentType
  comment     String?
  status      RentalCleaningStatus @default(ACTIVE)

  expenseTransactionId String  @unique // CashTransaction EXPENSE/DRY_CLEANING
  refundTransactionId  String? @unique // CashTransaction INCOME/DRY_CLEANING on cancel

  createdBy   String // staffId
  createdAt   DateTime  @default(now())
  cancelledBy String? // staffId
  cancelledAt DateTime?

  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id])
  variant            ProductVariant   @relation(fields: [variantId], references: [id])
  expenseTransaction CashTransaction  @relation("RentalCleaningExpense", fields: [expenseTransactionId], references: [id])
  refundTransaction  CashTransaction? @relation("RentalCleaningRefund", fields: [refundTransactionId], references: [id])

  @@index([warehouseId, variantId, endDate])
  @@index([storeId, startDate])
  @@map("rental_cleanings")
}

/**
 * =======================
 * RETURN ORDERS
 * =======================
 */
model ReturnedOrder {
  id          String            @id @default(uuid())
  orderId     String            @unique
  createdAt   DateTime          @default(now())
  createdBy   String
  status      ReturnOrderStatus
  totalAmount Decimal           @default(0)
  items       ReturnItem[]
  payments    ReturnPayment[]
  order       Order             @relation(fields: [orderId], references: [id])
}

model ReturnItem {
  id        String        @id @default(uuid())
  returnId  String
  itemId    String        @unique
  quantity  Int
  createdAt DateTime      @default(now())
  orderItem OrderItem     @relation(fields: [itemId], references: [id])
  return    ReturnedOrder @relation(fields: [returnId], references: [id])
}

model ReturnPayment {
  id            String        @id @default(uuid())
  returnOrderId String
  amount        Decimal
  type          PaymentType
  createdAt     DateTime      @default(now())
  createdBy     String
  cashier       Staff         @relation("ReturnPayments", fields: [createdBy], references: [id])
  return        ReturnedOrder @relation(fields: [returnOrderId], references: [id])
}

/**
 * =======================
 * PAYMENTS
 * =======================
 */

model Payment {
  id        String      @id @default(uuid())
  orderId   String
  type      PaymentType
  amount    Decimal
  paidAt    DateTime?
  createdAt DateTime    @default(now())
  createdBy String
  cashier   Staff       @relation("StaffPayments", fields: [createdBy], references: [id])
  order     Order       @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

/**
 * CASHBOX
 */
model Cashbox {
  id          String     @id @default(uuid())
  sellerId    String
  storeId     String
  status      CashStatus
  warehouseId String
  balance     Decimal    @default(0)
  createdAt   DateTime   @default(now())
  /// Set when the cashbox (shift) is closed
  closedAt    DateTime?

  seller Staff @relation(fields: [sellerId], references: [id])
  store  Store @relation(fields: [storeId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  transactions CashTransaction[]

  @@index([storeId, createdAt])
  @@index([warehouseId, createdAt])
}

model CashTransaction {
  id          String                  @id @default(uuid())
  cashboxId   String
  createdById String
  type        CashTransactionType
  category    CashTransactionCategory
  paymentType PaymentType

  amount  Decimal
  comment String?

  orderId String?
  debtId  String?

  createdAt DateTime @default(now())

  cashbox   Cashbox @relation(fields: [cashboxId], references: [id])
  createdBy Staff   @relation(fields: [createdById], references: [id])

  order Order?       @relation(fields: [orderId], references: [id])
  debt  DebtPayment? @relation(fields: [debtId], references: [id])

  rentalCleaningExpense RentalCleaning? @relation("RentalCleaningExpense")
  rentalCleaningRefund  RentalCleaning? @relation("RentalCleaningRefund")
}

model CustomerDebt {
  id          String     @id @default(uuid())
  storeId     String
  customerId  String
  description String?
  totalAmount Decimal
  paidAmount  Decimal    @default(0)
  status      DebtStatus
  createdAt   DateTime   @default(now())
  returnedAt  DateTime?

  customer Customer      @relation(fields: [customerId], references: [id])
  store    Store         @relation(fields: [storeId], references: [id])
  payments DebtPayment[]

  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
  @@index([status])
}

model DebtPayment {
  id        String      @id @default(uuid())
  debtId    String
  amount    Decimal
  type      PaymentType
  createdBy String
  createdAt DateTime    @default(now())

  debt    CustomerDebt @relation(fields: [debtId], references: [id])
  cashier Staff        @relation(fields: [createdBy], references: [id])

  cashTransactions CashTransaction[]
}

