/**
 * =======================
 * ENUMS
 * =======================
 */
enum DebtStatus {
  ACTIVE
  PAID
}

enum CashTransactionType {
  INCOME
  EXPENSE
}

enum CashTransactionCategory {
  SALE
  DEBT_PAYMENT
  RENT
  DELIVERY
  SALARY
  PURCHASE
  RETURN
  OTHER
  RENTAL // income of a rental order; not to be confused with RENT (premises rent expense)
  DRY_CLEANING // planned dry cleaning of a rental item (EXPENSE; INCOME when cancelled)
}

enum RentalStatus {
  BOOKED // booked, items are in the salon
  ISSUED // handed out to the customer
  PARTIALLY_RETURNED // some items are back
  RETURNED // all items are back
  CANCELLED // booking cancelled before issue
}

enum RentalCleaningStatus {
  ACTIVE
  CANCELLED
}

enum CollateralType {
  PASSPORT
  GOLD
  OTHER
}

enum CashStatus {
  OPEN
  CLOSED
}

enum UserRole {
  ADMIN
  OWNER
  USER
}

enum UserType {
  CUSTOMER
  STAFF
}

enum StaffRole {
  OWNER
  SELLER
  MANAGER
  CASHIER
  WAREHOUSE
}

/// Store subscription state (Store.status)
enum StoreStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

/// Why an admin suspended a store (Store.suspendReason)
enum StoreSuspendReason {
  UNPAID
  OWNER_REQUEST
  OTHER
}

/// Why an employee was deactivated (Staff.deactivationReason)
